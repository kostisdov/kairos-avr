{
  "$defs": {
    "Confidence": {
      "properties": {
        "canonical_model": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Canonical Model",
          "type": "number"
        },
        "route": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Route",
          "type": "number"
        },
        "size_mm": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Size Mm",
          "type": "number"
        }
      },
      "title": "Confidence",
      "type": "object"
    },
    "EchoObservation": {
      "properties": {
        "ar_grade": {
          "anyOf": [
            {
              "enum": [
                "none",
                "trace",
                "mild",
                "moderate",
                "severe"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar Grade"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "dvi": {
          "anyOf": [
            {
              "maximum": 1.5,
              "minimum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dvi"
        },
        "eoa_cm2": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0.1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eoa Cm2"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "lvef_pct": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lvef Pct"
        },
        "mean_gradient_mmhg": {
          "anyOf": [
            {
              "maximum": 150,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Gradient Mmhg"
        },
        "native_vs_prosthetic": {
          "default": "uncertain",
          "enum": [
            "prosthetic",
            "native",
            "uncertain"
          ],
          "title": "Native Vs Prosthetic",
          "type": "string"
        },
        "passport_id": {
          "title": "Passport Id",
          "type": "string"
        },
        "peak_velocity_ms": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Velocity Ms"
        },
        "source": {
          "default": "rule",
          "enum": [
            "rule",
            "llm",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "svi_ml_m2": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Svi Ml M2"
        }
      },
      "required": [
        "passport_id",
        "date"
      ],
      "title": "EchoObservation",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "method": {
          "enum": [
            "rule",
            "llm"
          ],
          "title": "Method",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        },
        "text": {
          "maxLength": 160,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "field",
        "span",
        "text",
        "method"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExposureEpisode": {
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "class": {
          "enum": [
            "VKA",
            "FXa",
            "DTI",
            "SAPT",
            "DAPT",
            "none"
          ],
          "title": "Class",
          "type": "string"
        },
        "indication": {
          "default": "unknown",
          "enum": [
            "AF",
            "VTE",
            "postop_prophylaxis",
            "suspected_valve_thrombosis",
            "other",
            "unknown"
          ],
          "title": "Indication",
          "type": "string"
        },
        "source": {
          "default": "prescription",
          "enum": [
            "prescription",
            "confirmed_adherence"
          ],
          "title": "Source",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "started_within_90d_after_suspicious_echo": {
          "default": false,
          "title": "Started Within 90D After Suspicious Echo",
          "type": "boolean"
        },
        "stop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop"
        }
      },
      "required": [
        "class",
        "start"
      ],
      "title": "ExposureEpisode",
      "type": "object"
    },
    "ExposureTimeline": {
      "properties": {
        "episodes": {
          "items": {
            "$ref": "#/$defs/ExposureEpisode"
          },
          "title": "Episodes",
          "type": "array"
        },
        "inr": {
          "items": {
            "$ref": "#/$defs/INRValue"
          },
          "title": "Inr",
          "type": "array"
        },
        "passport_id": {
          "title": "Passport Id",
          "type": "string"
        }
      },
      "required": [
        "passport_id"
      ],
      "title": "ExposureTimeline",
      "type": "object"
    },
    "INRValue": {
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "value": {
          "maximum": 12,
          "minimum": 0.5,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "date",
        "value"
      ],
      "title": "INRValue",
      "type": "object"
    },
    "LabObservation": {
      "properties": {
        "analyte": {
          "enum": [
            "creatinine",
            "egfr",
            "hba1c",
            "ldl",
            "non_hdl",
            "phosphate",
            "calcium_corrected",
            "calcium_ionised",
            "pth",
            "alp",
            "lpa",
            "ntprobnp",
            "hscrp",
            "dp_ucmgp",
            "lvef",
            "svi"
          ],
          "title": "Analyte",
          "type": "string"
        },
        "assay": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "assay name, recorded for research markers such as dp-ucMGP",
          "title": "Assay"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "passport_id": {
          "title": "Passport Id",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "passport_id",
        "date",
        "analyte",
        "value"
      ],
      "title": "LabObservation",
      "type": "object"
    },
    "Passport": {
      "properties": {
        "canonical_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Model"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "design_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design Class"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/PassportEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "generation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "implant_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implant Date"
        },
        "market_status": {
          "default": "unknown",
          "enum": [
            "active",
            "withdrawn",
            "discontinued",
            "unknown"
          ],
          "title": "Market Status",
          "type": "string"
        },
        "passport_id": {
          "title": "Passport Id",
          "type": "string"
        },
        "route": {
          "default": "unknown",
          "enum": [
            "SAVR",
            "TAVR",
            "unknown"
          ],
          "title": "Route",
          "type": "string"
        },
        "size_mm": {
          "anyOf": [
            {
              "maximum": 36,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Mm"
        },
        "source": {
          "$ref": "#/$defs/PassportSource"
        }
      },
      "required": [
        "source"
      ],
      "title": "Passport",
      "type": "object"
    },
    "PassportEvent": {
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        },
        "type": {
          "enum": [
            "valve_in_valve",
            "redo",
            "dysfunction",
            "endocarditis",
            "thrombosis"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PassportEvent",
      "type": "object"
    },
    "PassportSource": {
      "properties": {
        "date": {
          "description": "YYYY-MM-DD or YYYY",
          "title": "Date",
          "type": "string"
        },
        "note_ref": {
          "description": "opaque note reference; never note text",
          "title": "Note Ref",
          "type": "string"
        },
        "note_type": {
          "enum": [
            "operative",
            "procedure",
            "progress",
            "discharge"
          ],
          "title": "Note Type",
          "type": "string"
        }
      },
      "required": [
        "note_ref",
        "note_type",
        "date"
      ],
      "title": "PassportSource",
      "type": "object"
    },
    "PatientStatic": {
      "properties": {
        "age_at_implant": {
          "anyOf": [
            {
              "maximum": 105,
              "minimum": 18,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age At Implant"
        },
        "atrial_fibrillation": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atrial Fibrillation"
        },
        "bicuspid_native_valve": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bicuspid Native Valve"
        },
        "bmi": {
          "anyOf": [
            {
              "maximum": 70,
              "minimum": 12,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bmi"
        },
        "bsa_m2": {
          "anyOf": [
            {
              "maximum": 3.0,
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bsa M2"
        },
        "diabetes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes"
        },
        "diabetes_duration_years": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diabetes Duration Years"
        },
        "dialysis": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialysis"
        },
        "egfr_ml_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egfr Ml Min"
        },
        "lipid_lowering": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lipid Lowering"
        },
        "other_anticoagulation_indication": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other Anticoagulation Indication"
        },
        "sex": {
          "anyOf": [
            {
              "enum": [
                "F",
                "M"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex"
        },
        "smoking": {
          "anyOf": [
            {
              "enum": [
                "never",
                "former",
                "current"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smoking"
        }
      },
      "title": "PatientStatic",
      "type": "object"
    }
  },
  "properties": {
    "echo_observations": {
      "items": {
        "$ref": "#/$defs/EchoObservation"
      },
      "title": "Echo Observations",
      "type": "array"
    },
    "exposure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExposureTimeline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "jurisdiction": {
      "default": "ESC_EACTS",
      "enum": [
        "ESC_EACTS",
        "ACC_AHA"
      ],
      "title": "Jurisdiction",
      "type": "string"
    },
    "labs": {
      "items": {
        "$ref": "#/$defs/LabObservation"
      },
      "title": "Labs",
      "type": "array"
    },
    "passport": {
      "$ref": "#/$defs/Passport"
    },
    "prediction_time": {
      "title": "Prediction Time",
      "type": "string"
    },
    "source_kind": {
      "default": "synthetic",
      "enum": [
        "real",
        "synthetic"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "static": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatientStatic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "passport",
    "echo_observations",
    "prediction_time"
  ],
  "title": "PredictRequest",
  "type": "object"
}
